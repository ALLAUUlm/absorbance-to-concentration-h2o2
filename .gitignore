# Bulk experimental data stays local / on Nextcloud only.
# It's fully regenerated by running the notebooks in docs/evaluation_docs/
# against data/raw, or obtained from the lab's Nextcloud share.
data/raw/
data/processed/
data/evaluation/
data/old_evaluation/
data/raw_mrdga/
data/pre_metadata_raw/
data/pre_metadata_processed/

# Small sample datasets ARE tracked (see README): data/model_data/,
# one full old-measurement batch under data/pre_metadata_raw/ and its
# matching data/pre_metadata_processed/ entries, data/starting_times.csv,
# data/raw/demo_final_not_repeated.yaml. These are force-added
# (`git add -f`) individually rather than negated here, since gitignore
# negation doesn't reliably reach into an already-ignored parent directory.

# Python build artifacts
__pycache__/
*.egg-info/
